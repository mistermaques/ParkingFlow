<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador "1 Detalhes ——— 2 Confirmação" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/etapa1Circulo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_etapa_ativa"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/etapa1Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Detalhes"
        android:textColor="@color/texto_principal"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:background="@color/borda" />

    <TextView
        android:id="@+id/etapa2Circulo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_etapa_inativa"
        android:gravity="center"
        android:text="2"
        android:textColor="@color/texto_secundario"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/etapa2Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Confirmação"
        android:textColor="@color/texto_secundario"
        android:textSize="13sp" />

</LinearLayout>