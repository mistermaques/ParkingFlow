<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Parkingflow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Tela de abertura (splash): aparece enquanto o app abre, no lugar do símbolo do Android.
         Fundo claro do app + logo escura; depois troca para o tema normal (Theme.Parkingflow). -->
    <style name="Theme.Parkingflow.Abertura" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fundo_app</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_abertura</item>
        <item name="postSplashScreenTheme">@style/Theme.Parkingflow</item>
    </style>
</resources>